#cloud-config
# Attacker VM – installs the attack script but does NOT auto-start it.
# The reviewer manually triggers the attack to demonstrate the vulnerability.

package_update: true
package_upgrade: false
packages:
  - python3
  - python3-pip
  - python3-venv

write_files:
  # ── App directory ──────────────────────────────────────────────────────────

  - path: /opt/p2p-demo/requirements.txt
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, requirements_txt)}

  - path: /opt/p2p-demo/common.py
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, common_py)}

  - path: /opt/p2p-demo/attacker.py
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, attacker_py)}

  # ── Trusted server certificate ─────────────────────────────────────────────

  - path: /opt/p2p-demo/certs/server.crt
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, server_cert_pem)}

  # ── Environment file ────────────────────────────────────────────────────────

  - path: /opt/p2p-demo/attacker.env
    owner: root:root
    permissions: "0600"
    content: |
      AGENT_HOST=${agent_private_ip}
      WSS_PORT=${wss_port}
      CA_CERT_PATH=/opt/p2p-demo/certs/server.crt
      LOG_DIR=/var/log/p2p-demo

  # ── Systemd unit (installed but kept DISABLED – manual trigger only) ────────

  - path: /etc/systemd/system/attacker.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, attacker_service)}

runcmd:
  # Create runtime directories
  - mkdir -p /var/log/p2p-demo
  # Install Python dependencies into a venv
  - python3 -m venv /opt/p2p-demo/venv
  - /opt/p2p-demo/venv/bin/pip install --quiet -r /opt/p2p-demo/requirements.txt
  # Register the unit but leave it disabled – demo is manual
  - systemctl daemon-reload
  # NOTE: we intentionally do NOT enable or start the attacker service here.
  # Run the attack manually: python3 /opt/p2p-demo/attacker.py --once
