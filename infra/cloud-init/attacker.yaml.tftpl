#cloud-config
package_update: true
packages:
  - python3
  - python3-pip
  - python3-venv

write_files:
  - path: /opt/p2p-demo/requirements.txt
    encoding: b64
    permissions: "0644"
    content: ${base64encode(requirements_txt)}

  - path: /opt/p2p-demo/attacker.py
    encoding: b64
    permissions: "0755"
    content: ${base64encode(attacker_py)}

  # CA cert — attacker knows the CA exists and can verify the server cert.
  # Intentionally NO client cert here: in AUTH_MODE=mtls the agent requires
  # a client cert signed by this CA, which the attacker cannot present.
  - path: /opt/p2p-demo/certs/ca.crt
    encoding: b64
    permissions: "0644"
    content: ${base64encode(ca_cert_pem)}

  - path: /opt/p2p-demo/attacker.env
    permissions: "0600"
    content: |
      AGENT_HOST=${agent_private_ip}
      WSS_PORT=${wss_port}
      CA_CERT_PATH=/opt/p2p-demo/certs/ca.crt
      LOG_DIR=/var/log/p2p-demo

  - path: /etc/systemd/system/attacker.service
    encoding: b64
    permissions: "0644"
    content: ${base64encode(attacker_service)}

runcmd:
  - mkdir -p /var/log/p2p-demo
  - python3 -m venv /opt/p2p-demo/venv
  - /opt/p2p-demo/venv/bin/pip install --quiet -r /opt/p2p-demo/requirements.txt
  - systemctl daemon-reload
  # Attacker service installed but NOT started - run manually for the demo
