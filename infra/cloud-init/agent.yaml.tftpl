#cloud-config
package_update: true
packages:
  - python3
  - python3-pip
  - python3-venv

write_files:
  - path: /opt/p2p-demo/requirements.txt
    encoding: b64
    permissions: "0644"
    content: ${base64encode(requirements_txt)}

  - path: /opt/p2p-demo/agent.py
    encoding: b64
    permissions: "0755"
    content: ${base64encode(agent_py)}

  # CA cert — used to verify twin client certificates in AUTH_MODE=mtls
  - path: /opt/p2p-demo/certs/ca.crt
    encoding: b64
    permissions: "0644"
    content: ${base64encode(ca_cert_pem)}

  # Server cert + key signed by the CA above
  - path: /opt/p2p-demo/certs/server.crt
    encoding: b64
    permissions: "0644"
    content: ${base64encode(server_cert_pem)}

  - path: /opt/p2p-demo/certs/server.key
    encoding: b64
    permissions: "0600"
    content: ${base64encode(server_key_pem)}

  - path: /opt/p2p-demo/agent.env
    permissions: "0600"
    content: |
      AUTH_MODE=${auth_mode}
      SCHEDULE_TOKEN=${schedule_token}
      WSS_PORT=${wss_port}
      CERT_PATH=/opt/p2p-demo/certs/server.crt
      KEY_PATH=/opt/p2p-demo/certs/server.key
      CA_CERT_PATH=/opt/p2p-demo/certs/ca.crt
      STATE_DIR=/var/lib/p2p-demo
      LOG_DIR=/var/log/p2p-demo

  - path: /etc/systemd/system/agent.service
    encoding: b64
    permissions: "0644"
    content: ${base64encode(agent_service)}

runcmd:
  - mkdir -p /var/lib/p2p-demo /var/log/p2p-demo
  - python3 -m venv /opt/p2p-demo/venv
  - /opt/p2p-demo/venv/bin/pip install --quiet -r /opt/p2p-demo/requirements.txt
  - systemctl daemon-reload
  - systemctl enable agent
  - systemctl start agent
