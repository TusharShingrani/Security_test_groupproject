#cloud-config
package_update: true
packages:
  - python3
  - python3-pip
  - python3-venv

write_files:
  - path: /opt/p2p-demo/requirements.txt
    encoding: b64
    permissions: "0644"
    content: ${base64encode(requirements_txt)}

  - path: /opt/p2p-demo/twin.py
    encoding: b64
    permissions: "0755"
    content: ${base64encode(twin_py)}

  - path: /opt/p2p-demo/certs/server.crt
    encoding: b64
    permissions: "0644"
    content: ${base64encode(server_cert_pem)}

  - path: /opt/p2p-demo/twin.env
    permissions: "0600"
    content: |
      AUTH_MODE=${auth_mode}
      SCHEDULE_TOKEN=${schedule_token}
      AGENT_HOST=${agent_private_ip}
      WSS_PORT=${wss_port}
      CA_CERT_PATH=/opt/p2p-demo/certs/server.crt
      LOG_DIR=/var/log/p2p-demo

  - path: /home/${admin_username}/.ssh/poc_rsa
    encoding: b64
    permissions: "0600"
    content: ${base64encode(ssh_private_key)}

  - path: /etc/systemd/system/twin.service
    encoding: b64
    permissions: "0644"
    content: ${base64encode(twin_service)}

runcmd:
  - mkdir -p /var/log/p2p-demo
  - mkdir -p /home/${admin_username}/.ssh
  - chown ${admin_username}:${admin_username} /home/${admin_username}/.ssh /home/${admin_username}/.ssh/poc_rsa
  - chmod 700 /home/${admin_username}/.ssh
  - python3 -m venv /opt/p2p-demo/venv
  - /opt/p2p-demo/venv/bin/pip install --quiet -r /opt/p2p-demo/requirements.txt
  - systemctl daemon-reload
  - systemctl enable twin
  - systemctl start twin
