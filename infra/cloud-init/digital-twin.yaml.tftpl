#cloud-config
# Digital Twin VM – bootstraps the WSS client and SSH hop key on first boot.

package_update: true
package_upgrade: false
packages:
  - python3
  - python3-pip
  - python3-venv

write_files:
  # ── App directory ──────────────────────────────────────────────────────────

  - path: /opt/p2p-demo/requirements.txt
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, requirements_txt)}

  - path: /opt/p2p-demo/common.py
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, common_py)}

  - path: /opt/p2p-demo/twin.py
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, twin_py)}

  # ── Trusted server certificate ─────────────────────────────────────────────

  - path: /opt/p2p-demo/certs/server.crt
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, server_cert_pem)}

  # ── Environment file ────────────────────────────────────────────────────────

  - path: /opt/p2p-demo/twin.env
    owner: root:root
    permissions: "0600"
    content: |
      AUTH_MODE=${auth_mode}
      SCHEDULE_TOKEN=${schedule_token}
      AGENT_HOST=${agent_private_ip}
      WSS_PORT=${wss_port}
      CA_CERT_PATH=/opt/p2p-demo/certs/server.crt
      LOG_DIR=/var/log/p2p-demo

  # ── SSH private key for hopping to private VMs ─────────────────────────────
  # Written to the azureuser home dir so the reviewer can hop from here.

  - path: /home/${admin_username}/.ssh/poc_rsa
    owner: ${admin_username}:${admin_username}
    permissions: "0600"
    content: |
      ${indent(6, ssh_private_key)}

  # ── Systemd unit ────────────────────────────────────────────────────────────

  - path: /etc/systemd/system/digital-twin.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, twin_service)}

runcmd:
  # Create runtime directories
  - mkdir -p /var/log/p2p-demo
  # Install Python dependencies into a venv
  - python3 -m venv /opt/p2p-demo/venv
  - /opt/p2p-demo/venv/bin/pip install --quiet -r /opt/p2p-demo/requirements.txt
  # Enable and start the twin service
  - systemctl daemon-reload
  - systemctl enable digital-twin
  - systemctl start digital-twin
