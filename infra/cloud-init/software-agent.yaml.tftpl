#cloud-config
# Software Agent VM – bootstraps the WSS server on first boot.

package_update: true
package_upgrade: false
packages:
  - python3
  - python3-pip
  - python3-venv

write_files:
  # ── App directory ──────────────────────────────────────────────────────────

  - path: /opt/p2p-demo/requirements.txt
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, requirements_txt)}

  - path: /opt/p2p-demo/common.py
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, common_py)}

  - path: /opt/p2p-demo/agent.py
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, agent_py)}

  # ── TLS certificate + key (server identity) ────────────────────────────────

  - path: /opt/p2p-demo/certs/server.crt
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, server_cert_pem)}

  - path: /opt/p2p-demo/certs/server.key
    owner: root:root
    permissions: "0600"
    content: |
      ${indent(6, server_key_pem)}

  # ── Environment file ────────────────────────────────────────────────────────

  - path: /opt/p2p-demo/agent.env
    owner: root:root
    permissions: "0600"
    content: |
      AUTH_MODE=${auth_mode}
      SCHEDULE_TOKEN=${schedule_token}
      WSS_PORT=${wss_port}
      CERT_PATH=/opt/p2p-demo/certs/server.crt
      KEY_PATH=/opt/p2p-demo/certs/server.key
      STATE_DIR=/var/lib/p2p-demo
      LOG_DIR=/var/log/p2p-demo

  # ── Systemd unit ────────────────────────────────────────────────────────────

  - path: /etc/systemd/system/software-agent.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, agent_service)}

runcmd:
  # Create runtime directories
  - mkdir -p /var/lib/p2p-demo /var/log/p2p-demo
  # Install Python dependencies into a venv
  - python3 -m venv /opt/p2p-demo/venv
  - /opt/p2p-demo/venv/bin/pip install --quiet -r /opt/p2p-demo/requirements.txt
  # Enable and start the agent service
  - systemctl daemon-reload
  - systemctl enable software-agent
  - systemctl start software-agent
