[Unit]
Description=Attacker WSS client – PoC for unauthorized client demo (manual trigger only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/p2p-demo
EnvironmentFile=/opt/p2p-demo/attacker.env
ExecStart=/opt/p2p-demo/venv/bin/python3 /opt/p2p-demo/attacker.py --once
StandardOutput=journal
StandardError=journal
SyslogIdentifier=attacker

# NOTE: This service is installed but NOT enabled.
# Trigger the demo manually:
#   python3 /opt/p2p-demo/attacker.py --once
#   python3 /opt/p2p-demo/attacker.py --loop

[Install]
WantedBy=multi-user.target
