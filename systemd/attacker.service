[Unit]
Description=Attacker WSS client (manual trigger only)
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/p2p-demo
EnvironmentFile=/opt/p2p-demo/attacker.env
ExecStart=/opt/p2p-demo/venv/bin/python3 /opt/p2p-demo/attacker.py --once
StandardOutput=journal
StandardError=journal

# This service is intentionally NOT enabled.
# Run the attack manually: python3 /opt/p2p-demo/attacker.py --once

[Install]
WantedBy=multi-user.target
